# The process layer: what was planned, what was actually done, under which conditions, and
# what came out -- including what did not work.
#
# It builds on the science core, whose Process, InformationEntity and StudyResult it
# extends, and imports it.
#
# Two separations are the whole point of this ontology, and both of them are places where a
# flat record silently loses the science.
#
# A plan is not a run. Protocol and ProtocolStep are information: what the paper says should
# happen. Experiment and ExecutionStep are occurrents: what happened. They have different
# identities and are related by `realises`, which is asserted when somebody or something has
# actually matched them up -- never by having the same name. The science core declares
# InformationEntity and Process disjoint, so this separation is an axiom an engine can fail
# on, not a convention.
#
# A negative result is a result. NegativeResult is a subclass of StudyResult, beside
# PositiveResult and disjoint from it, so it is found by every query that finds results,
# ranked by every ranking that ranks them and pulled into every evidence package. An
# ontology that modelled outcomes as a flag on a result would have made "what has been tried
# and did not work" unanswerable, which is the question this architecture exists for.
#
# The REPRODUCE-ME identities are taken from the archived snapshot of that ontology cited in
# the architecture catalogue. They are the IRIs of that snapshot, which is what is claimed
# here -- not that the upstream ontology still publishes them all:
#
#   https://github.com/sensein/assertion-evidence-paper/blob/main/Data/provenance/reproduce-me.owl
#
# This base module is in every tractable profile. `process_rl.ttl` adds the chains that
# carry an experiment's conditions to the results it yielded.

@prefix proc:  <https://w3id.org/atlas-of-science/process#> .
@prefix repro: <https://w3id.org/reproduceme#> .
@prefix core:  <https://w3id.org/atlas-of-science/core#> .
@prefix field: <https://w3id.org/atlas-of-science/fields#> .
@prefix atlas: <https://w3id.org/atlas-of-science/substrate#> .
@prefix owl:   <http://www.w3.org/2002/07/owl#> .
@prefix rdfs:  <http://www.w3.org/2000/01/rdf-schema#> .
@prefix skos:  <http://www.w3.org/2004/02/skos/core#> .
@prefix obo:   <http://purl.obolibrary.org/obo/> .
@prefix sepio: <https://w3id.org/sepio-framework/sepio-linkml/> .

<https://w3id.org/atlas-of-science/process>
    a owl:Ontology ;
    rdfs:label "Atlas of Science: plans, runs, conditions and outcomes" ;
    owl:versionIRI <https://w3id.org/atlas-of-science/process/0.2> ;
    owl:imports <https://w3id.org/atlas-of-science/science_core> ;
    atlas:profile "EL", "QL", "RL", "DL" .

repro:Protocol a owl:Class ;
    atlas:name "Protocol" ; rdfs:subClassOf obo:IAO_0000030 ;
    skos:definition "The procedure as written; a description, which is never the doing of it." ;
    atlas:fields ( field:name field:version field:definition ) ; atlas:labelField field:name .

proc:ProtocolStep a owl:Class ;
    atlas:name "ProtocolStep" ; rdfs:subClassOf obo:IAO_0000030 ;
    skos:definition "One step of a protocol as planned, in the order the protocol gives it." ;
    atlas:fields ( field:name field:order field:definition ) ; atlas:labelField field:name .

repro:Experiment a owl:Class ;
    atlas:name "Experiment" ; rdfs:subClassOf obo:BFO_0000015 ;
    skos:definition "One carrying-out of a procedure, which happened at a time." ;
    atlas:fields ( field:name field:version field:definition ) ; atlas:labelField field:name .

proc:ExecutionStep a owl:Class ;
    atlas:name "ExecutionStep" ; rdfs:subClassOf obo:BFO_0000015 ;
    skos:definition "One step as it was actually carried out, in the order it happened." ;
    atlas:fields ( field:name field:order field:definition ) ; atlas:labelField field:name .

repro:ExperimentalCondition a owl:Class ;
    atlas:name "ExperimentalCondition" ; rdfs:subClassOf obo:IAO_0000030 ;
    skos:definition "One condition a run was carried out under, with its value and its unit." ;
    atlas:fields ( field:name field:value field:unit field:definition ) ; atlas:labelField field:name .

repro:PositiveResult a owl:Class ;
    atlas:name "PositiveResult" ; rdfs:subClassOf sepio:StudyResult ;
    skos:definition "An outcome in which the effect looked for was found." ;
    atlas:fields ( field:statement field:value field:unit field:conditions field:definition ) ;
    atlas:labelField field:statement .

repro:NegativeResult a owl:Class ;
    atlas:name "NegativeResult" ; rdfs:subClassOf sepio:StudyResult ;
    skos:definition "An outcome in which the effect looked for was not found, which is a result." ;
    atlas:fields ( field:statement field:value field:unit field:conditions field:definition ) ;
    atlas:labelField field:statement .

repro:PositiveResult owl:disjointWith repro:NegativeResult .

proc:follows a owl:ObjectProperty ;
    atlas:name "follows" ; rdfs:domain repro:Experiment ; rdfs:range repro:Protocol ;
    skos:definition "The run was carried out according to this written procedure." .

proc:plannedStep a owl:ObjectProperty ;
    atlas:name "planned_step" ; rdfs:domain repro:Protocol ; rdfs:range proc:ProtocolStep ;
    skos:definition "The procedure says this step should happen." .

proc:actualStep a owl:ObjectProperty ;
    atlas:name "actual_step" ; rdfs:domain repro:Experiment ; rdfs:range proc:ExecutionStep ;
    skos:definition "This step happened during the run." .

proc:realises a owl:ObjectProperty ;
    atlas:name "realises" ; rdfs:domain proc:ExecutionStep ; rdfs:range proc:ProtocolStep ;
    skos:definition "Somebody matched this step that happened to that step that was planned." .

proc:underCondition a owl:ObjectProperty ;
    atlas:name "under_condition" ; rdfs:domain repro:Experiment ;
    rdfs:range repro:ExperimentalCondition ;
    skos:definition "The run was carried out under this condition." .

proc:yielded a owl:ObjectProperty ;
    atlas:name "yielded" ; rdfs:domain repro:Experiment ; rdfs:range sepio:StudyResult ;
    skos:definition "The run produced this outcome, whichever way it came out." .

proc:obtainedUnder a owl:ObjectProperty ;
    atlas:name "obtained_under" ; rdfs:domain sepio:StudyResult ;
    rdfs:range repro:ExperimentalCondition ;
    skos:definition "The result was obtained under this condition, because the run that yielded it was. Inferred by a property chain in the RL module; an extractor may assert it too." .

proc:plannedFor a owl:ObjectProperty ;
    atlas:name "planned_for" ; rdfs:domain repro:Experiment ; rdfs:range proc:ProtocolStep ;
    skos:definition "The run was meant to carry out this step, because the protocol it follows plans it. Inferred; what `align` compares the actual steps against." .
