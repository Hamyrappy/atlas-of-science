# The map layer: topics, and the passages a salience pass kept.
#
# It builds on the science core, whose InformationEntity and Entity it uses, and imports it.
#
# The one thing this ontology exists to enforce is a separation. A topic is not a class.
# Two things the corpus talks about in the same paragraphs belong to one topic; that says
# they are discussed together and says nothing about what either of them is. The map layer
# is therefore its own class with its own identity, related to entities by `in_topic` and
# never by `rdfs:subClassOf`, so that nothing downstream -- no engine least of all -- can
# mistake a cluster for a definition. `induce` and `promote` are the only route from the
# first to the second, and they produce a proposal a person reads, not an axiom.
#
# A Topic corresponds to a SKOS concept (`skos:closeMatch skos:Concept`), and `narrower` to
# `skos:narrower`: a map, still not a hierarchy of classes.
#
# Passage is what a salience pass keeps: a region of a source that carries something worth
# extracting from, under a category the run named. The categories are not here -- they are
# a configuration, because which distinctions matter is a property of the corpus and of the
# question, not of this vocabulary.

@prefix map:   <https://w3id.org/atlas-of-science/map#> .
@prefix field: <https://w3id.org/atlas-of-science/fields#> .
@prefix atlas: <https://w3id.org/atlas-of-science/substrate#> .
@prefix owl:   <http://www.w3.org/2002/07/owl#> .
@prefix rdfs:  <http://www.w3.org/2000/01/rdf-schema#> .
@prefix skos:  <http://www.w3.org/2004/02/skos/core#> .
@prefix obo:   <http://purl.obolibrary.org/obo/> .

<https://w3id.org/atlas-of-science/science_map>
    a owl:Ontology ;
    rdfs:label "Atlas of Science: the science map" ;
    owl:versionIRI <https://w3id.org/atlas-of-science/science_map/0.2> ;
    owl:imports <https://w3id.org/atlas-of-science/science_core> ;
    atlas:profile "EL", "QL", "RL", "DL" .

map:Topic a owl:Class ;
    atlas:name "Topic" ; rdfs:subClassOf obo:IAO_0000030 ;
    skos:closeMatch skos:Concept ;
    skos:definition "A group of things the corpus discusses together, which is not a class of them." ;
    atlas:fields ( field:label field:scope field:definition ) ; atlas:labelField field:label .

map:Passage a owl:Class ;
    atlas:name "Passage" ; rdfs:subClassOf obo:IAO_0000030 ;
    skos:definition "A region of a source a salience pass kept, under the category it kept it for." ;
    atlas:fields ( field:category field:summary field:definition ) ; atlas:labelField field:summary .

map:inTopic a owl:ObjectProperty ;
    atlas:name "in_topic" ; rdfs:domain obo:BFO_0000001 ; rdfs:range map:Topic ;
    skos:definition "The thing is discussed under this topic, which says nothing about what it is." .

map:narrower a owl:ObjectProperty ;
    atlas:name "narrower" ; rdfs:domain map:Topic ; rdfs:range map:Topic ;
    skos:closeMatch skos:narrower ;
    skos:definition "A finer topic within a broader one; still a map, still not a hierarchy of classes." .

map:mentions a owl:ObjectProperty ;
    atlas:name "mentions" ; rdfs:domain map:Passage ; rdfs:range obo:BFO_0000001 ;
    skos:definition "The kept passage talks about this thing." .
